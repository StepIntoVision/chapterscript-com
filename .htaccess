# Internal documentation is never a public site asset, including in subdirectories.
<FilesMatch "(?i)\.(md|markdown)$">
    Require all denied
</FilesMatch>

# Keep Hostinger's existing HTTPS redirect. HSTS is honored only over HTTPS;
# omit includeSubDomains/preload so this policy does not affect other subdomains.
Header always set Strict-Transport-Security "max-age=31536000"
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "DENY"
Header always set Referrer-Policy "same-origin"

# Add a policy rather than replacing the endpoint's stricter CSP or Hostinger's
# upgrade-insecure-requests policy. Browsers enforce all policies together.
Header always append Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"

ErrorDocument 404 /404.html
